# Export the routing of every ring-oscillator net (n0, n1, n2 inside each ro_cell) from a
# routed design as FIXED_ROUTE constraints -> constraints/puf_routes.xdc.
#
# Why: LOC/BEL/LOCK_PINS fix where each RO's LUTs sit, but the router still chooses the
# wires between them in every build. Those wires dominate the RO delay, so without this
# file every rebuild (e.g. a firmware change) changed ~20 % of the PUF response bits.
# With it, every build that uses the same RO placement gets bit-identical RO loops.
#
#   vivado -mode batch -nojournal -nolog -source scripts/export_puf_routes.tcl -tclargs <routed.dcp>

set root [file normalize [file dirname [info script]]/..]
set dcp  [lindex $argv 0]
open_checkpoint $dcp

set nets [get_nets -hierarchical -filter {NAME =~ u_puf/g_arr[*].u_arr/g_ro[*].u_ro/n*}]
set f [open $root/constraints/puf_routes.xdc w]
fconfigure $f -translation lf
puts $f "# GENERATED by scripts/export_puf_routes.tcl from [file tail $dcp] -- do not edit by hand."
puts $f "# Fixed routing of the [llength $nets] ring-oscillator nets (see the script for why)."
set n 0
foreach net $nets {
    set route [get_property ROUTE $net]
    if {$route eq "" || [get_property ROUTE_STATUS $net] ne "ROUTED"} {
        error "net $net is not fully routed"
    }
    puts $f "set_property FIXED_ROUTE {$route} \[get_nets {$net}\]"
    incr n
}
close $f
puts "EXPORT_OK $n RO nets -> constraints/puf_routes.xdc"

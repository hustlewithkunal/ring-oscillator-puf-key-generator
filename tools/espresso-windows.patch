diff --git a/espresso-src/util_signature.c b/espresso-src/util_signature.c
index 0652e79..6e0a0bd 100644
--- a/espresso-src/util_signature.c
+++ b/espresso-src/util_signature.c
@@ -21,15 +21,23 @@
 #include "espresso.h"
 #include "signature.h"
 #include <sys/time.h>
+#ifndef _WIN32  /* RTL_Project patch: rlimit is not available on MinGW */
 #include <sys/resource.h>
+#endif
 #include <unistd.h>
 
 void
 set_time_limit(int seconds)
 {
+#ifdef _WIN32
+	/* RTL_Project patch: no CPU-time limit on Windows (only affects the
+	   optional time-out of the signature-based exact mode) */
+	(void) seconds;
+#else
 	struct rlimit rlp_st, *rlp = &rlp_st;
 	rlp->rlim_cur = seconds;
 	setrlimit(RLIMIT_CPU, rlp);
+#endif
 }
 
 void

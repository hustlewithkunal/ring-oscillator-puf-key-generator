+/* RTL_Project patch: Windows/MinGW has no getrusage(); use the C library clock() */
+#ifdef _WIN32
+#include <time.h>
+long util_cpu_time(void)
+{
+    return (long) (clock() * 1000.0 / CLOCKS_PER_SEC);
+}
